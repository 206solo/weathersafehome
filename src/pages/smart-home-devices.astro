<BaseLayout
  title="Smart Home Devices for Weather Protection — Buying Guide"
  description="Which smart home devices actually protect your home from weather damage. Leak sensors, automatic water shutoffs, smart smoke and CO alarms, freeze detection, and what fails when the power goes out."
>

  <!-- Hero -->
  <section class="threat-hero">
    <div class="hero-img-wrap">
